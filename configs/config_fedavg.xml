<fedwork_cfg name="fedavg" num_of_nodes="10" net_port="36525" net_ip="127.0.0.1" eval_criterion="CrossEntropyLoss" num_of_rounds="200">
	<dataset type="FashionMNIST">
		<var name="heterogeneous">False</var>
		<var name="alpha">100</var>
		<var name="train_batch_size">100</var>
		<var name="test_batch_size">100</var>
		<var name="num_workers">0</var>
		<var name="save_graph">True</var>
		<var name="enclosed_info">True</var>
		<var name="dirichlet">True</var>
	</dataset>
	<localclients learning_rate="0.01" optimizer="SGD" platform="cpu">10</localclients>
	<method name="FedAvgExample" type="FedAvg" platform="cpu">
		<arch type="CNNSimpleLite">
		</arch>
		<var name="epochs_num">3</var>
		<var name="args">contributors_percent=100</var>
	</method>
	<report save_log="True" log_over_net="192.168.166.143,23456">
		<fig style="style=bmh;colors=black,green,blue,red;linestyles=--,:,-.,-;linewidths=1,1,1,1;" name="Accuracy" caption=" " x_axis="round" y_axis="EvaluationAccuracy" y_axis_title="Accuracy" x_axis_title="# rounds" methods="FedAvgExample" labels="FedAvg"/>
	</report>
</fedwork_cfg>