<fedwork_cfg
    name="bin_cifar10_vgg7_0_1_ablation"
    experiment_mode="true"
    seed="42"
    num_of_nodes="10"
    net_port="36575"
    net_ip="127.0.0.1"
    eval_criterion="CrossEntropyLoss"
    num_of_rounds="800">

    <dataset type="CIFAR10_BOP">
        <var name="train_batch_size">100</var>
        <var name="test_batch_size">100</var>
        <var name="num_workers">8</var>
        <var name="save_graph">True</var>
        <var name="enclosed_info">True</var>
        <var name="dirichlet">True</var>
        <var name="alpha">0.1</var>
        <var name="equal_client_sizes">True</var>
    </dataset>

    <localclients
        learning_rate="0.05"
        momentum="0.0"
        weight_decay="0.0"
        optimizer="Adam"
        platform="cuda:0">10
    </localclients>
    <method
        name="FedBopSync50"
        type="FedBop"
        platform="cuda:0">

        <arch type="VGG7Bin">
            <var name="VGGMode">0</var>
            <var name="NumberOfChannels">3</var>
            <var name="InputDataLen">32</var>
            <var name="NumberOfOutputNodes">10</var>
            <var name="FedVoteK">1.5</var>
            <var name="FedVoteSharedSeed">42</var>
        </arch>

        <var name="epochs_num">1</var>
        <var name="args">
            decay_factor=0.1,decay_rounds=200,sync_rounds=50,gamma=0.0001,tau=0.00000001,stats_lr=0.01,contributors_percent=100,diag=0
        </var>
    </method>
    <method
        name="FedBopSync100"
        type="FedBop"
        platform="cuda:0">

        <arch type="VGG7Bin">
            <var name="VGGMode">0</var>
            <var name="NumberOfChannels">3</var>
            <var name="InputDataLen">32</var>
            <var name="NumberOfOutputNodes">10</var>
            <var name="FedVoteK">1.5</var>
            <var name="FedVoteSharedSeed">42</var>
        </arch>

        <var name="epochs_num">1</var>
        <var name="args">
            decay_factor=0.1,decay_rounds=200,sync_rounds=100,gamma=0.0001,tau=0.00000001,stats_lr=0.01,contributors_percent=100,diag=0
        </var>
    </method>
    <method
        name="FedBopSync200"
        type="FedBop"
        platform="cuda:0">

        <arch type="VGG7Bin">
            <var name="VGGMode">0</var>
            <var name="NumberOfChannels">3</var>
            <var name="InputDataLen">32</var>
            <var name="NumberOfOutputNodes">10</var>
            <var name="FedVoteK">1.5</var>
            <var name="FedVoteSharedSeed">42</var>
        </arch>

        <var name="epochs_num">1</var>
        <var name="args">
            decay_factor=0.1,decay_rounds=200,sync_rounds=200,gamma=0.0001,tau=0.00000001,stats_lr=0.01,contributors_percent=100,diag=0
        </var>
    </method>
    <method
        name="FedBopWithoutSync"
        type="FedBop"
        platform="cuda:0">

        <arch type="VGG7Bin">
            <var name="VGGMode">0</var>
            <var name="NumberOfChannels">3</var>
            <var name="InputDataLen">32</var>
            <var name="NumberOfOutputNodes">10</var>
            <var name="FedVoteK">1.5</var>
            <var name="FedVoteSharedSeed">42</var>
        </arch>

        <var name="epochs_num">1</var>
        <var name="args">
            decay_factor=0.1,decay_rounds=200,sync_rounds=800,gamma=0.0001,tau=0.00000001,stats_lr=0.01,contributors_percent=100,diag=0
        </var>
    </method>
    <method
        name="FedBopWithoutLocalMajority"
        type="FedBop_wolmaj"
        platform="cuda:0">

        <arch type="VGG7Bin">
            <var name="VGGMode">0</var>
            <var name="NumberOfChannels">3</var>
            <var name="InputDataLen">32</var>
            <var name="NumberOfOutputNodes">10</var>
            <var name="FedVoteK">1.5</var>
            <var name="FedVoteSharedSeed">42</var>
        </arch>

        <var name="epochs_num">1</var>
        <var name="args">
            decay_factor=0.1,decay_rounds=200,sync_rounds=200,gamma=0.0001,tau=0.00000001,stats_lr=0.01,contributors_percent=100,diag=0
        </var>
    </method>
    <method
        name="FedBopWithoutAggregationKPower"
        type="FedBop_woagrrk"
        platform="cuda:0">

        <arch type="VGG7Bin">
            <var name="VGGMode">0</var>
            <var name="NumberOfChannels">3</var>
            <var name="InputDataLen">32</var>
            <var name="NumberOfOutputNodes">10</var>
            <var name="FedVoteK">1.5</var>
            <var name="FedVoteSharedSeed">42</var>
        </arch>

        <var name="epochs_num">1</var>
        <var name="args">
            decay_factor=0.1,decay_rounds=200,sync_rounds=200,gamma=0.0001,tau=0.00000001,stats_lr=0.01,contributors_percent=100,diag=0
        </var>
    </method>
    <report save_log="True" log_over_net="192.168.0.138,6443">
        <fig
            style="style=bmh;axis_font_size=16;legend_font_size=14;legend_pos=lower_left;legend_ncol=3;bbox_to_anchor=0.0,1.00;legend_status=on;colors=black,green,blue,orange;linewidths=1,1,1,1;"
            name="accuracy_diff_sync"
            caption=" "
            x_axis="round"
            y_axis="EvaluationAccuracy"
            y_axis_title="Top-1 Accuracy"
            x_axis_title="Communication Round"
            methods="FedBopSync50,FedBopSync100,FedBopSync200,FedBopWithoutSync"
            labels="Sync-50,Sync-100,Sync-200,No Sync" />

        <fig:pf
            style="style=bmh;axis_font_size=16;legend_font_size=14;legend_pos=lower_left;legend_ncol=3;bbox_to_anchor=0.0,1.00;legend_status=on;colors=black,green,blue,orange;linewidths=1,1,1,1;"
            name="accuracy_vs_uplink_diff_sync"
            caption=" "
            x_axis="ServerTotalRecvBytes"
            x_axis_scale="1e-9"
            y_axis="EvaluationAccuracy"
            y_axis_title="Top-1 Accuracy"
            x_axis_title="Cumulative uplink (GB)"
            methods="FedBopSync50,FedBopSync100,FedBopSync200,FedBopWithoutSync"
            labels="Sync-50,Sync-100,Sync-200,No Sync" />

        <fig:pf
            style="style=bmh;axis_font_size=16;legend_font_size=14;legend_pos=lower_left;legend_ncol=3;bbox_to_anchor=0.0,1.00;legend_status=on;colors=black,green,blue,orange;linewidths=1,1,1,1;"
            name="accuracy_vs_downlink_diff_sync"
            caption=" "
            x_axis="ServerTotalSentBytes"
            x_axis_scale="1e-9"
            y_axis="EvaluationAccuracy"
            y_axis_title="Top-1 Accuracy"
            x_axis_title="Cumulative downlink (GB)"
            methods="FedBopSync50,FedBopSync100,FedBopSync200,FedBopWithoutSync"
            labels="Sync-50,Sync-100,Sync-200,No Sync" />

        <fig
            style="style=bmh;axis_font_size=16;legend_font_size=14;legend_pos=lower_left;legend_ncol=3;bbox_to_anchor=0.0,1.00;legend_status=on;colors=black,green,blue,orange;linewidths=1,1,1,1;"
            name="accuracy_diff_sync_abl2"
            caption=" "
            x_axis="round"
            y_axis="EvaluationAccuracy"
            y_axis_title="Top-1 Accuracy"
            x_axis_title="Communication Round"
            methods="FedBopSync200,FedBopWithoutLocalMajority,FedBopWithoutAggregationKPower"
            labels="Full FedBop,Without Local Majority,Without K-Power" />

        <fig:pf
            style="style=bmh;axis_font_size=16;legend_font_size=14;legend_pos=lower_left;legend_ncol=3;bbox_to_anchor=0.0,1.00;legend_status=on;colors=black,green,blue,orange;linewidths=1,1,1,1;"
            name="accuracy_vs_uplink_diff_sync_abl2"
            caption=" "
            x_axis="ServerTotalRecvBytes"
            x_axis_scale="1e-9"
            y_axis="EvaluationAccuracy"
            y_axis_title="Top-1 Accuracy"
            x_axis_title="Cumulative uplink (GB)"
            methods="FedBopSync200,FedBopWithoutLocalMajority,FedBopWithoutAggregationKPower"
            labels="Full FedBop,Without Local Majority,Without K-Power" />

        <fig:pf
            style="style=bmh;axis_font_size=16;legend_font_size=14;legend_pos=lower_left;legend_ncol=3;bbox_to_anchor=0.0,1.00;legend_status=on;colors=black,green,blue,orange;linewidths=1,1,1,1;"
            name="accuracy_vs_downlink_diff_sync_abl2"
            caption=" "
            x_axis="ServerTotalSentBytes"
            x_axis_scale="1e-9"
            y_axis="EvaluationAccuracy"
            y_axis_title="Top-1 Accuracy"
            x_axis_title="Cumulative downlink (GB)"
            methods="FedBopSync200,FedBopWithoutLocalMajority,FedBopWithoutAggregationKPower"
            labels="Full FedBop,Without Local Majority,Without K-Power" />
    </report>
</fedwork_cfg>