<fedwork_cfg name="fedala_mia_comparison" num_of_nodes="10" net_port="36525" net_ip="127.0.0.1" eval_criterion="CrossEntropyLoss" num_of_rounds="300">
	<dataset type="CIFAR100">
		<var name="alpha">0.1</var>
		<var name="train_batch_size">100</var>
		<var name="test_batch_size">100</var>
		<var name="num_workers">0</var>
		<var name="save_graph">True</var>
		<var name="enclosed_info">True</var>
		<var name="dirichlet">True</var>
	</dataset>

	<localclients learning_rate="0.01" momentum="0.9" weight_decay="5e-4" optimizer="SGD" platform="cuda:1">10</localclients>
	<method name="Baseline" type="FedALA" platform="cuda:1">
		<arch type="ResNet18">
		</arch>
		<var name="epochs_num">1</var>
		<var name="args">lcr=1,alpha=0</var>
	</method>
	<method name="FedAvgMixUp" type="FedALA" platform="cuda:1">
		<arch type="ResNet18">
		</arch>
		<var name="epochs_num">1</var>
		<var name="args">lcr=1,alpha=0,mixup_alpha=0.4</var>
	</method>
	<method name="FedALA_0_3_100" type="FedALA" platform="cuda:1">
		<arch type="ResNet18">
		</arch>
		<var name="epochs_num">1</var>
		<var name="args">lcr=0.3,alpha=100</var>
	</method>
	<method name="FedAvgLDP" type="FedALA" platform="cuda:1">
		<arch type="ResNet18">
		</arch>
		<var name="epochs_num">1</var>
		<var name="args">lcr=1,alpha=0,ldp_noise_std=0.05</var>
	</method>
	<method name="FedAvgRQ" type="FedALA" platform="cuda:1">
		<arch type="ResNet18">
		</arch>
		<var name="epochs_num">1</var>
		<var name="args">lcr=1,alpha=0,randomized_quantization_levels=256</var>
	</method>
	<method name="FedAvgGS" type="FedALA" platform="cuda:1">
		<arch type="ResNet18">
		</arch>
		<var name="epochs_num">1</var>
		<var name="args">lcr=1,alpha=0,gradient_sparsifier=0.2</var>
	</method>
	<method name="FedAvgDPSGD" type="FedAvgDPSGD" platform="cuda:1">
		<arch type="ResNet18">
		</arch>
		<var name="epochs_num">1</var>
		<var name="args">noise_multiplier=0.5,max_grad_norm=2.0</var>
	</method>

	<report save_log="True" log_over_net="141.30.246.151,23456">
		<fig style="style=bmh;linewidths=1,1,1,1,1,1,1;" name="Link_D1" caption=" " x_axis="round" y_axis_scale="1e-9" y_axis_title="Total Recevied Data (GB)" y_axis="ServerDataRecvBytes" x_axis_title="# Rounds" methods="Baseline,FedALA_0_1_10,FedALA_0_3_10,FedALA_0_5_10,FedALA_0_7_10" labels="Baseline,LCR = 10%,LCR = 30%,LCR = 50%,LCR = 70%" />
		<fig style="style=bmh;colors=black,green,blue,red;linestyles=--,:;linewidths=1,1,1,1,1,1;" name="MIA_TPR_D1" caption=" " x_axis="round" y_axis="MIA_TPRS_0_01" y_axis_title="TPR@FPR1%" x_axis_title="# Rounds" methods="Baseline,FedAvgMixUp,FedALA_0_1_10,FedALA_0_3_10,FedALA_0_5_10,FedALA_0_7_10" labels="Baseline,MixUp,LCR = 10%,LCR = 30%,LCR = 50%,LCR = 70%"/>
		<fig style="style=bmh;colors=black,green,blue,red;linestyles=--,:;linewidths=1,1,1,1,1,1;" name="Accuracy_D1" caption=" " x_axis="round" y_axis="EvaluationAccuracy" y_axis_title="Accuracy" x_axis_title="# Rounds" methods="Baseline,FedAvgMixUp,FedALA_0_1_10,FedALA_0_3_10,FedALA_0_5_10,FedALA_0_7_10" labels="Baseline,MixUp,LCR = 10%,LCR = 30%,LCR = 50%,LCR = 70%"/>
	</report>
</fedwork_cfg>