<fedwork_cfg name="fedavg_medmnist_resnet18" num_of_nodes="10" net_port="36525" net_ip="127.0.0.1" eval_criterion="CrossEntropyLoss" num_of_rounds="10">
	<dataset type="MedMNIST-PathMNIST">
		<var name="heterogeneous">False</var>
		<var name="non_iid_level">0</var>
		<var name="train_batch_size">100</var>
		<var name="test_batch_size">100</var>
		<var name="num_workers">0</var>
		<var name="save_graph">True</var>
		<var name="enclosed_info">True</var>
		<var name="dirichlet">False</var>
	</dataset>

	<localclients learning_rate="0.01" momentum="0.9" weight_decay="5e-4" optimizer="SGD" platform="cuda:1">10</localclients>
	<method name="FedAvg" type="FedALA" platform="cuda:1">
		<arch type="ResNet18">
		</arch>
		<var name="epochs_num">1</var>
		<var name="args">lcr=0.1,alpha=300</var>
	</method>
	<report save_log="True" log_over_net="192.168.166.143,23456">
		<fig style="style=bmh;colors=black,green,blue,red;linestyles=--,:,-.,-;linewidths=1,1,1,1;" name="Accuracy" caption=" " x_axis="round" y_axis="EvaluationAccuracy" y_axis_title="Accuracy" x_axis_title="# rounds" methods="FedAvg" labels="FedAvg"/>
</report>
</fedwork_cfg>