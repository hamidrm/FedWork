<fedwork_cfg name="fedalaq_cifar10_vit" experiment_mode="true" seed="42" num_of_nodes="10" net_port="36575" net_ip="127.0.0.1" eval_criterion="CrossEntropyLoss" num_of_rounds="500">
	<dataset type="CIFAR10">
		<var name="alpha">0.1</var>
		<var name="train_batch_size">100</var>
		<var name="test_batch_size">100</var>
		<var name="num_workers">8</var>
		<var name="save_graph">True</var>
		<var name="enclosed_info">True</var>
		<var name="dirichlet">True</var>
	</dataset>

	<localclients learning_rate="0.01" momentum="0.9" weight_decay="5e-4" optimizer="SGD" platform="cuda:0">10</localclients>
	<method name="FedALAQ_0_2_10" type="FedALAQ" platform="cuda:0">
		<arch type="ViTTinyCIFAR10">
		</arch>
		<var name="epochs_num">3</var>
		<var name="args">lcr=0.3,alpha=100,randomized_quantization_levels=256,fedmia_stride=501,contributors_percent=100</var>
	</method>
	<method name="FedAvg" type="FedALAQ" platform="cuda:0">
		<arch type="ViTTinyCIFAR10">
		</arch>
		<var name="epochs_num">3</var>
		<var name="args">lcr=1.0,alpha=0,randomized_quantization_levels=256,fedmia_stride=501,contributors_percent=100</var>
	</method>
	<report save_log="True" log_over_net="192.168.0.157,23456">
		<fig name="accuracy" caption=" " x_axis="round" y_axis="EvaluationAccuracy" y_axis_title="Top-1 Accuracy" x_axis_title="Rounds" methods="FedALAQ_0_2_10,FedAvg" labels="FedALAQ,FedAvg"  />
		<fig name="Link_D0_1" caption=" " x_axis="round" y_axis="ServerTotalRecvBytes" y_axis_title="Total Uplink Cost" x_axis_title="# Rounds" methods="FedALAQ_0_2_10,FedAvg" labels="FedALAQ,FedAvg"  />
		<fig name="Cosim" caption=" " x_axis="round" y_axis="FedALAQ_no_layers_1" y_axis_title="sim" x_axis_title="# Rounds" methods="FedALAQ_0_2_10,FedAvg" labels="FedALAQ,FedAvg"  />
		<fig:pf style="style=bmh;axis_font_size=16;legend_font_size=14;legend_pos=lower_left;legend_ncol=4;bbox_to_anchor=0.0,1.00;legend_status=off;colors=black,green,blue,red,darkorange,navy,darkcyan,slategray,purple;linewidths=1,1,1,1,1,1;" name="acc_vs_upl_d100_0" caption=" " x_axis="ServerTotalRecvBytes" x_axis_scale="1e-9" y_axis="EvaluationAccuracy" y_axis_title="Top-1 Accuracy" x_axis_title="Total uplink cost (GB)" methods="FedALAQ_0_2_10,FedAvg" labels="FedALAQ,FedAvg"  />
	
	
	</report>
</fedwork_cfg>