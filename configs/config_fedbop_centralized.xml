<fedwork_cfg name="fedbop_centralized" experiment_mode="true" seed="42" num_of_nodes="1" net_port="36575" net_ip="127.0.0.1" eval_criterion="CrossEntropyLoss" num_of_rounds="500">
	<dataset type="CIFAR10_BOP">
		<var name="train_batch_size">50</var>
		<var name="test_batch_size">50</var>
		<var name="num_workers">8</var>
		<var name="save_graph">True</var>
		<var name="enclosed_info">True</var>
		<var name="dirichlet">False</var>
	</dataset>

	<localclients learning_rate="0.01" momentum="0.9" weight_decay="5e-4" optimizer="SGD" platform="cuda:0">1</localclients>

	<method name="FBOP" type="FedBop" platform="cuda:0">
		<arch type="BinaryNet">
		</arch>
		<var name="epochs_num">1</var>
		<var name="args">gamma=0.0001,tau=0.00000001,contributors_percent=100</var>
	</method>
	<method name="FBOPDecay" type="FedBop" platform="cuda:0">
		<arch type="BinaryNet">
		</arch>
		<var name="epochs_num">1</var>
		<var name="args">decay_factor=0.1,decay_rounds=100,gamma=0.0001,tau=0.00000001,contributors_percent=100</var>
	</method>
	<method name="FBOPDecayAdam" type="FedBop" platform="cuda:0">
		<arch type="BinaryNet">
		</arch>
		<var name="epochs_num">1</var>
		<var name="args">decay_factor=0.1,decay_rounds=100,gamma=0.0001,tau=0.00000001,contributors_percent=100</var>
	</method>
	<report save_log="True" log_over_net="192.168.0.157,23456">
		<fig style="style=bmh;axis_font_size=16;legend_font_size=14;legend_pos=lower_left;legend_ncol=4;bbox_to_anchor=0.0,1.00;legend_status=on;colors=black,green,blue,red,darkorange,navy,darkcyan,slategray,purple;linewidths=1,1,1,1,1,1;" name="accuracy_d0_1_round" caption=" " x_axis="round" y_axis="EvaluationAccuracy" y_axis_title="Top-1 Accuracy" x_axis_title="RND" methods="FBOP,FBOPDecay,FBOPDecayAdam" labels="FedBop,+Decay,+Adam"  />
	</report>
</fedwork_cfg>